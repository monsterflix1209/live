    <!-- Modal: PeerServer Config -->
    <div id="peerConfigModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 space-y-4">
            <h3 class="font-bold text-base text-white flex items-center gap-2">
                <i class="fa-solid fa-server text-blue-400"></i> PeerJS 信令伺服器設定
            </h3>
            <div class="space-y-3 text-xs">
                <div>
                    <label class="block text-slate-400 mb-1">PeerServer 主機 (Host)</label>
                    <input type="text" id="peerHostInput" placeholder="預設使用 PeerJS 公用伺服器" class="w-full bg-slate-950 border border-slate-800 rounded p-2 text-white">
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-slate-400 mb-1">Port</label>
                        <input type="number" id="peerPortInput" placeholder="443" class="w-full bg-slate-950 border border-slate-800 rounded p-2 text-white">
                    </div>
                    <div>
                        <label class="block text-slate-400 mb-1">Path</label>
                        <input type="text" id="peerPathInput" placeholder="/" class="w-full bg-slate-950 border border-slate-800 rounded p-2 text-white">
