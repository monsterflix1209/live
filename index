    <script>
        // ==================== GLOBAL SYSTEM STATE ====================
        let currentRole = 'studio';
        let roomId = 'live-demo-room';
        let peer = null;
        let peerCustomConfig = null; // Custom PeerServer config if set
        let activeConnections = {}; // Stores connections in studio
        let localMediaStream = null;
        let mediaRecorder = null;
        let recordedChunks = [];
        let isRecording = false;

        // Canvas Switcher State
        let pgmCanvas, pgmCtx, pvwCanvas, pvwCtx;
        let cameraSources = {
            cam1: { element: null, label: 'Cam 1 (未連接)', stream: null, vol: 1.0 },
            cam2: { element: null, label: 'Cam 2 (未連接)', stream: null, vol: 1.0 },
            cam3: { element: null, label: 'Cam 3 (未連接)', stream: null, vol: 1.0 },
            cam4: { element: null, label: 'Cam 4 (未連接)', stream: null, vol: 1.0 },
        };
        let activePvwSource = 'cam1';
        let activePgmSource = 'cam1';
        let currentLayout = 'single'; // 'single', 'pip', 'split', 'grid'
        let overlays = {
            lowerThird: false,
            ticker: false
        };

        // Audio Context Mixing
        let audioCtx, masterGainNode;

        // ==================== INITIALIZATION ====================
        window.addEventListener('load', () => {
            // Global error handlers to prevent WebSocket SecurityError from crashing the app in iframe sandbox
            window.addEventListener('error', (e) => {
                if (e.message && (e.message.includes('WebSocket') || e.message.includes('SecurityError'))) {
                    e.preventDefault();
                    showWsWarning('當前預覽環境 (iFrame Sandbox) 限制 WebSocket 連線。系統已自動啟用單機預覽導播模式，所有切換與錄影功能均可正常測試！發佈至 GitHub Pages 後即可復原跨裝置傳輸。');
                }
            });
            window.addEventListener('unhandledrejection', (e) => {
                if (e.reason && e.reason.toString().includes('WebSocket')) {
                    e.preventDefault();
                    showWsWarning('當前預覽環境 (iFrame Sandbox) 限制 WebSocket 連線。系統已自動啟用單機預覽導播模式。');
                }
            });

            initCanvases();
            initAudioContext();
            renderCameraSlots();
            switchRole('studio');
            startCompositorLoop();
        });

        function updateRoomId(val) {
            roomId = val.trim() || 'live-demo-room';
            console.log('Room ID updated:', roomId);
        }

        // View Navigation Switcher
        function switchRole(role) {
            currentRole = role;
            document.querySelectorAll('.role-module').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.role-tab').forEach(el => {
                el.classList.remove('bg-blue-600', 'text-white');
                el.classList.add('text-slate-400');
            });

            document.getElementById(`module-${role}`).classList.remove('hidden');
            const activeTab = document.getElementById(`tab-${role}`);
            activeTab.classList.add('bg-blue-600', 'text-white');
            activeTab.classList.remove('text-slate-400');

            if (role === 'studio' && !peer) {
                initStudio();
            } else if (role === 'camera') {
                populateDevices();
            } else if (role === 'viewer') {
                connectAsViewer();
            }
        }

        // ==================== CANVAS COMPOSITOR & SWITCHER ====================
        function initCanvases() {
            pgmCanvas = document.getElementById('pgmCanvas');
            pgmCtx = pgmCanvas.getContext('2d');
            pvwCanvas = document.getElementById('pvwCanvas');
            pvwCtx = pvwCanvas.getContext('2d');

            // Set canvas resolutions
            pgmCanvas.width = 1280;
            pgmCanvas.height = 720;
            pvwCanvas.width = 1280;
            pvwCanvas.height = 720;
        }

        function initAudioContext() {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            audioCtx = new AudioContext();
            masterGainNode = audioCtx.createGain();
            masterGainNode.gain.value = 1.0;
            masterGainNode.connect(audioCtx.destination);
        }

        // Render Canvas Loop (60 FPS)
        function startCompositorLoop() {
            function drawFrame() {
                // Render PVW
                renderCanvasSource(pvwCtx, activePvwSource, currentLayout);
                
                // Render PGM
                renderCanvasSource(pgmCtx, activePgmSource, currentLayout);
                
                // Render Overlays on PGM
                if (overlays.lowerThird) {
                    drawLowerThirdOverlay(pgmCtx);
                }
                if (overlays.ticker) {
                    drawTickerOverlay(pgmCtx);
                }

                requestAnimationFrame(drawFrame);
            }
            requestAnimationFrame(drawFrame);
        }

        function renderCanvasSource(ctx, sourceKey, layout) {
            ctx.fillStyle = '#090d16';
            ctx.fillRect(0, 0, 1280, 720);

            const source = cameraSources[sourceKey];

            if (layout === 'single') {
                if (source && source.element && source.element.readyState >= 2) {
                    ctx.drawImage(source.element, 0, 0, 1280, 720);
                } else {
                    drawNoSignal(ctx, sourceKey, 0, 0, 1280, 720);
                }
            } else if (layout === 'pip') {
                // Main stream
                if (source && source.element && source.element.readyState >= 2) {
                    ctx.drawImage(source.element, 0, 0, 1280, 720);
                } else {
                    drawNoSignal(ctx, sourceKey, 0, 0, 1280, 720);
                }
                // Small sub window (Cam 2 or fallback)
                const subSourceKey = sourceKey === 'cam1' ? 'cam2' : 'cam1';
                const subSource = cameraSources[subSourceKey];
                ctx.strokeStyle = '#3b82f6';
                ctx.lineWidth = 4;
                ctx.strokeRect(860, 440, 380, 240);
                if (subSource && subSource.element && subSource.element.readyState >= 2) {
                    ctx.drawImage(subSource.element, 860, 440, 380, 240);
                } else {
                    drawNoSignal(ctx, subSourceKey, 860, 440, 380, 240);
                }
            } else if (layout === 'split') {
                // Split 50/50
                const camA = cameraSources['cam1'];
                const camB = cameraSources['cam2'];
                if (camA && camA.element && camA.element.readyState >= 2) {
                    ctx.drawImage(camA.element, 0, 0, 635, 720);
                } else {
                    drawNoSignal(ctx, 'Cam 1', 0, 0, 635, 720);
                }
                if (camB && camB.element && camB.element.readyState >= 2) {
                    ctx.drawImage(camB.element, 645, 0, 635, 720);
                } else {
                    drawNoSignal(ctx, 'Cam 2', 645, 0, 635, 720);
                }
            } else if (layout === 'grid') {
                // 4-Grid
                const slots = ['cam1', 'cam2', 'cam3', 'cam4'];
                const coords = [
                    [0, 0, 635, 355],
                    [645, 0, 635, 355],
                    [0, 365, 635, 355],
                    [645, 365, 635, 355]
                ];
                slots.forEach((key, idx) => {
                    const c = cameraSources[key];
                    const [x, y, w, h] = coords[idx];
                    if (c && c.element && c.element.readyState >= 2) {
                        ctx.drawImage(c.element, x, y, w, h);
                    } else {
                        drawNoSignal(ctx, key.toUpperCase(), x, y, w, h);
                    }
                });
            }
        }

        function drawNoSignal(ctx, label, x, y, w, h) {
            ctx.fillStyle = '#1e293b';
            ctx.fillRect(x, y, w, h);
            ctx.fillStyle = '#64748b';
            ctx.font = 'bold 24px sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(`無訊號 (${label})`, x + w / 2, y + h / 2);
        }

        // Lower Third Title Overlay
        function drawLowerThirdOverlay(ctx) {
            const title = document.getElementById('inputLtTitle').value || '即時直播';
            const sub = document.getElementById('inputLtSub').value || 'OmniLive Studio';
            
            ctx.fillStyle = 'rgba(15, 23, 42, 0.85)';
            ctx.fillRect(50, 560, 450, 90);
            
            ctx.fillStyle = '#3b82f6';
            ctx.fillRect(50, 560, 8, 90);
            
            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 26px sans-serif';
            ctx.textAlign = 'left';
            ctx.fillText(title, 75, 600);
            
            ctx.fillStyle = '#60a5fa';
            ctx.font = '18px sans-serif';
            ctx.fillText(sub, 75, 630);
        }

        // Ticker Marquee Overlay
        let tickerPos = 1280;
        function drawTickerOverlay(ctx) {
            const text = document.getElementById('inputTicker').value || '歡迎收看線上直播！';
            ctx.fillStyle = 'rgba(15, 23, 42, 0.9)';
            ctx.fillRect(0, 680, 1280, 40);
            
            ctx.fillStyle = '#38bdf8';
            ctx.font = 'bold 18px sans-serif';
            ctx.textAlign = 'left';
            ctx.fillText(text, tickerPos, 706);
            
            tickerPos -= 3;
            if (tickerPos < -ctx.measureText(text).width) {
                tickerPos = 1280;
            }
        }

        // Switcher Actions
        function selectPvwSource(key) {
            activePvwSource = key;
            document.getElementById('pvwSourceText').innerText = `Source: ${key.toUpperCase()}`;
            highlightActiveSlot();
        }

        function triggerCut() {
            activePgmSource = activePvwSource;
            document.getElementById('pgmSourceText').innerText = `Source: ${activePgmSource.toUpperCase()}`;
            highlightActiveSlot();
        }

        function triggerAutoFade() {
            // Simplified smooth cut
            triggerCut();
        }

        function setLayout(mode) {
            currentLayout = mode;
            document.querySelectorAll('.layout-btn').forEach(btn => btn.classList.remove('border-blue-500'));
            event.currentTarget.classList.add('border-blue-500');
        }

        function toggleOverlay(type) {
            overlays[type] = !overlays[type];
        }

        function renderCameraSlots() {
            const container = document.getElementById('cameraSlotsContainer');
            container.innerHTML = '';
            Object.keys(cameraSources).forEach(key => {
                const slot = cameraSources[key];
                const card = document.createElement('div');
                card.id = `slot-card-${key}`;
                card.onclick = () => selectPvwSource(key);
                card.className = `cursor-pointer bg-slate-950 border-2 ${activePvwSource === key ? 'border-yellow-500' : 'border-slate-800'} rounded-xl p-2 transition hover:border-slate-600 relative`;
                card.innerHTML = `
                    <div class="flex justify-between items-center mb-1">
                        <span class="font-bold text-xs uppercase text-slate-300">${key}</span>
                        <span id="badge-${key}" class="text-[10px] px-1.5 py-0.5 rounded bg-slate-800 text-slate-500">離線</span>
                    </div>
                    <div class="aspect-video bg-black rounded-lg overflow-hidden flex items-center justify-center">
                        <video id="vid-${key}" autoplay playsinline muted class="w-full h-full object-cover"></video>
                    </div>
                `;
                container.appendChild(card);
                
                // Save element ref
                cameraSources[key].element = card.querySelector(`video`);
            });
        }

        function highlightActiveSlot() {
            Object.keys(cameraSources).forEach(key => {
                const card = document.getElementById(`slot-card-${key}`);
                if (card) {
                    if (activePgmSource === key) {
                        card.className = card.className.replace(/border-\S+/, 'border-red-500');
                    } else if (activePvwSource === key) {
                        card.className = card.className.replace(/border-\S+/, 'border-yellow-500');
                    } else {
                        card.className = card.className.replace(/border-\S+/, 'border-slate-800');
                    }
                }
            });
        }

        // ==================== WEBRTC DIRECTOR STUDIO ====================
        function initStudio() {
            const studioPeerId = `${roomId}-studio`;
            const statusEl = document.getElementById('studioPeerStatus');
            if (statusEl) {
                statusEl.innerHTML = '<span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span> 連線至 PeerJS 伺服器...';
            }
            
            if (peer) {
                try { peer.destroy(); } catch(e) {}
                peer = null;
            }

            try {
                // Initialize Peer with custom or default config
                peer = peerCustomConfig ? new Peer(studioPeerId, peerCustomConfig) : new Peer(studioPeerId);

                peer.on('open', (id) => {
                    if (statusEl) statusEl.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-500"></span> 導播室運作中 (Ready)';
                    hideWsWarning();
                    console.log('Studio Master Peer ID:', id);
                });

                // Handle incoming calls (Camera Nodes or Viewers)
                peer.on('call', (call) => {
                    const callerId = call.peer;
                    console.log('Incoming call from:', callerId);

                    if (callerId.includes('-cam-')) {
                        call.answer();
                        call.on('stream', (remoteStream) => {
                            assignCameraStream(callerId, remoteStream);
                        });
                    } else if (callerId.includes('-viewer-')) {
                        const pgmStream = pgmCanvas.captureStream(30);
                        call.answer(pgmStream);
                    }
                });

                peer.on('error', (err) => {
                    console.warn('PeerJS Error handled:', err);
                    handlePeerError(err);
                });
            } catch (err) {
                console.warn('PeerJS Instantiation Error caught:', err);
                handlePeerError(err);
            }
        }

        function handlePeerError(err) {
            const statusEl = document.getElementById('studioPeerStatus');
            const errStr = err ? (err.message || err.toString()) : '';
            
            if (errStr.includes('SecurityError') || errStr.includes('WebSocket') || errStr.includes('Canvas')) {
                if (statusEl) statusEl.innerHTML = '<span class="w-2 h-2 rounded-full bg-blue-400"></span> 單機預覽展示模式';
                showWsWarning('當前 Preview 預覽視窗 (iFrame Sandbox) 限制跨網域 WebSocket 連線。導播切換、攝影機測試與 PGM 錄影功能仍可正常運作！部署至 GitHub Pages 後可完美支援跨裝置 WebRTC 串流。');
            } else {
                if (statusEl) statusEl.innerHTML = '<span class="w-2 h-2 rounded-full bg-amber-500"></span> 離線展示模式';
                showWsWarning(`信令伺服器連線提示: ${errStr || '連線受阻'}。系統已自動啟用單機預覽模式。`);
            }
        }

        function showWsWarning(msg) {
            const banner = document.getElementById('wsWarningBanner');
            if (banner) {
                if (msg) document.getElementById('wsWarningText').innerText = msg;
                banner.classList.remove('hidden');
            }
        }

        function hideWsWarning() {
            const banner = document.getElementById('wsWarningBanner');
            if (banner) banner.classList.add('hidden');
        }

        function showPeerConfigModal() {
            document.getElementById('peerConfigModal').classList.remove('hidden');
        }

        function hidePeerConfigModal() {
            document.getElementById('peerConfigModal').classList.add('hidden');
        }

        function savePeerConfig() {
            const host = document.getElementById('peerHostInput').value.trim();
            const port = document.getElementById('peerPortInput').value.trim();
            const path = document.getElementById('peerPathInput').value.trim();

            if (host) {
                peerCustomConfig = {
                    host: host,
                    port: port ? parseInt(port) : 443,
                    path: path || '/',
                    secure: true
                };
            } else {
                peerCustomConfig = null;
            }
            hidePeerConfigModal();
            initStudio();
        }

        function assignCameraStream(callerId, stream) {
            let slotKey = 'cam1';
            if (callerId.includes('cam1')) slotKey = 'cam1';
            else if (callerId.includes('cam2')) slotKey = 'cam2';
            else if (callerId.includes('cam3')) slotKey = 'cam3';
            else if (callerId.includes('cam4')) slotKey = 'cam4';

            cameraSources[slotKey].stream = stream;
            const videoElem = document.getElementById(`vid-${slotKey}`);
            if (videoElem) {
                videoElem.srcObject = stream;
            }

            const badge = document.getElementById(`badge-${slotKey}`);
            if (badge) {
                badge.innerText = 'ONLINE';
                badge.className = 'text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400 font-bold';
            }

            updateConnectedCamCount();
        }

        function updateConnectedCamCount() {
            const count = Object.values(cameraSources).filter(s => s.stream !== null).length;
            const el = document.getElementById('camCountText');
            if (el) el.innerText = `${count} 台設備`;
        }

        // ==================== CAMERA NODE LOGIC ====================
        async function populateDevices() {
            try {
                const devices = await navigator.mediaDevices.enumerateDevices();
                const videoSelect = document.getElementById('videoSelect');
                const audioSelect = document.getElementById('audioSelect');
                videoSelect.innerHTML = '';
                audioSelect.innerHTML = '';

                devices.forEach(device => {
                    const option = document.createElement('option');
                    option.value = device.deviceId;
                    if (device.kind === 'videoinput') {
                        option.text = device.label || `Camera ${videoSelect.length + 1}`;
                        videoSelect.appendChild(option);
                    } else if (device.kind === 'audioinput') {
                        option.text = device.label || `Microphone ${audioSelect.length + 1}`;
                        audioSelect.appendChild(option);
                    }
                });
            } catch (e) {
                console.error('Error listing devices:', e);
            }
        }

        async function startCameraNode() {
            const videoId = document.getElementById('videoSelect').value;
            const audioId = document.getElementById('audioSelect').value;
            const slot = document.getElementById('camSlotSelect').value;

            try {
                localMediaStream = await navigator.mediaDevices.getUserMedia({
                    video: { deviceId: videoId ? { exact: videoId } : undefined, width: 1280, height: 720 },
                    audio: audioId ? { deviceId: { exact: audioId } } : true
                });

                document.getElementById('camLocalVideo').srcObject = localMediaStream;
                document.getElementById('camPlaceholder').classList.add('hidden');

                // Assign to studio slot locally as fallback
                assignCameraStream(`cam-${slot}`, localMediaStream);

                // Connect via WebRTC if peer active
                connectCameraToStudio(slot, localMediaStream);
            } catch (e) {
                alert('無法存取攝影機或麥克風：' + e.message);
            }
        }

        async function startScreenShareNode() {
            const slot = document.getElementById('camSlotSelect').value;
            try {
                localMediaStream = await navigator.mediaDevices.getDisplayMedia({
                    video: { cursor: "always" },
                    audio: true
                });

                document.getElementById('camLocalVideo').srcObject = localMediaStream;
                document.getElementById('camPlaceholder').classList.add('hidden');

                // Assign to studio slot locally as fallback
                assignCameraStream(`cam-${slot}`, localMediaStream);

                connectCameraToStudio(slot, localMediaStream);
            } catch (e) {
                console.error('Screen share error:', e);
            }
        }

        function connectCameraToStudio(slotKey, stream) {
            const camPeerId = `${roomId}-cam-${slotKey}-${Math.floor(Math.random()*1000)}`;
            const studioPeerId = `${roomId}-studio`;
            const tally = document.getElementById('cameraTally');

            try {
                const camPeer = new Peer(camPeerId);
                camPeer.on('open', () => {
                    if (tally) {
                        tally.innerText = '連線至導播室中...';
                        tally.className = 'px-3 py-1.5 rounded-lg font-bold text-xs bg-yellow-500/20 text-yellow-400 border border-yellow-500/30';
                    }

                    const call = camPeer.call(studioPeerId, stream);
                    if (call) {
                        call.on('open', () => {
                            if (tally) {
                                tally.innerText = 'ON AIR 正式播出';
                                tally.className = 'px-3 py-1.5 rounded-lg font-bold text-xs bg-red-600 text-white tally-onair';
                            }
                        });
                    }
                });

                camPeer.on('error', (err) => {
                    console.warn('Cam Peer error:', err);
                    if (tally) {
                        tally.innerText = '單機鏡頭預覽中 (Local)';
                        tally.className = 'px-3 py-1.5 rounded-lg font-bold text-xs bg-blue-600 text-white';
                    }
                });
            } catch (err) {
                console.warn('Cam Peer instantiation error caught:', err);
                if (tally) {
                    tally.innerText = '單機鏡頭預覽中 (Local)';
                    tally.className = 'px-3 py-1.5 rounded-lg font-bold text-xs bg-blue-600 text-white';
                }
            }
        }

        // ==================== VIEWER PLAYER LOGIC ====================
        function connectAsViewer() {
            const viewerPeerId = `${roomId}-viewer-${Math.floor(Math.random()*10000)}`;
            const studioPeerId = `${roomId}-studio`;
            const video = document.getElementById('viewerVideo');

            try {
                const viewerPeer = new Peer(viewerPeerId);
                viewerPeer.on('open', () => {
                    console.log('Viewer peer ready:', viewerPeerId);
                    const dummyStream = createEmptyAudioStream();
                    const call = viewerPeer.call(studioPeerId, dummyStream);

                    if (call) {
                        call.on('stream', (remotePgmStream) => {
                            if (video) video.srcObject = remotePgmStream;
                        });
                    }
                });

                viewerPeer.on('error', (err) => {
                    console.warn('Viewer Peer error:', err);
                    if (video && pgmCanvas) {
                        video.srcObject = pgmCanvas.captureStream(30);
                    }
                });
            } catch (err) {
                console.warn('Viewer Peer instantiation error caught:', err);
                if (video && pgmCanvas) {
                    video.srcObject = pgmCanvas.captureStream(30);
                }
            }
        }

        function createEmptyAudioStream() {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = ctx.createOscillator();
            const dst = ctx.createMediaStreamDestination();
            osc.connect(dst);
            osc.start();
            return dst.stream;
        }

        function unmuteViewer() {
            const video = document.getElementById('viewerVideo');
            if (video) video.muted = false;
            const overlay = document.getElementById('unmuteOverlay');
            if (overlay) overlay.classList.add('hidden');
        }

        function sendEmoji(emoji) {
            const layer = document.getElementById('emojiLayer');
            if (!layer) return;
            const el = document.createElement('div');
            el.className = 'floating-emoji';
            el.innerText = emoji;
            el.style.left = `${Math.random() * 80 + 10}%`;
            layer.appendChild(el);
            setTimeout(() => el.remove(), 2000);
        }

        function sendChatMessage(e) {
            e.preventDefault();
            const input = document.getElementById('chatInput');
            const msg = input.value.trim();
            if (!msg) return;

            const box = document.getElementById('chatMessages');
            const item = document.createElement('div');
            item.className = 'bg-slate-800 p-2.5 rounded-xl border border-slate-700/50';
            item.innerHTML = `<span class="font-bold text-blue-400">觀眾: </span><span class="text-slate-200">${escapeHtml(msg)}</span>`;
            box.appendChild(item);
            box.scrollTop = box.scrollHeight;

            input.value = '';
        }

        // ==================== RECORDING & UTILS ====================
        function toggleRecord() {
            if (!isRecording) {
                startRecording();
            } else {
                stopRecording();
            }
        }

        function startRecording() {
            const pgmStream = pgmCanvas.captureStream(60);
            recordedChunks = [];
            mediaRecorder = new MediaRecorder(pgmStream, { mimeType: 'video/webm' });

            mediaRecorder.ondataavailable = (e) => {
                if (e.data.size > 0) recordedChunks.push(e.data);
            };

            mediaRecorder.onstop = () => {
                const blob = new Blob(recordedChunks, { type: 'video/webm' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `Live_Record_${new Date().toISOString().slice(0,19)}.webm`;
                a.click();
            };

            mediaRecorder.start();
            isRecording = true;
            const btn = document.getElementById('recordBtn');
            btn.className = 'px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold rounded-lg flex items-center gap-1.5 border border-red-500';
            btn.innerHTML = '<i class="fa-solid fa-square text-red-500"></i> 停止錄影';
        }

        function stopRecording() {
            if (mediaRecorder) mediaRecorder.stop();
            isRecording = false;
            const btn = document.getElementById('recordBtn');
            btn.className = 'px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white text-xs font-semibold rounded-lg flex items-center gap-1.5';
            btn.innerHTML = '<i class="fa-solid fa-circle text-[10px]"></i> 開始錄影';
        }

        function showConnectQRModal() {
            const modal = document.getElementById('qrModal');
            const container = document.getElementById('qrcodeCanvas');
            container.innerHTML = '';
            
            const shareUrl = `${window.location.origin}${window.location.pathname}?room=${roomId}&role=camera`;
            new QRCode(container, {
                text: shareUrl,
                width: 180,
                height: 180
            });
            modal.classList.remove('hidden');
        }

        function hideConnectQRModal() {
            document.getElementById('qrModal').classList.add('hidden');
        }

        function copyShareLink() {
            const shareUrl = `${window.location.origin}${window.location.pathname}?room=${roomId}`;
            navigator.clipboard.writeText(shareUrl).then(() => {
                alert('直播間分享連結已複製到剪貼簿！');
            });
        }

        function escapeHtml(str) {
            return str.replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[m]);
        }
    </script>
</body>
