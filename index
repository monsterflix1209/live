<!DOCTYPE html>
<html lang="zh-TW" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WebRTC 多端雲端直播導播系統 (GitHub Pages 專用)</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                        },
                        studio: {
                            bg: '#0f172a',
                            panel: '#1e293b',
                            border: '#334155',
                            accent: '#3b82f6',
                            pgm: '#ef4444',
                            pvw: '#eab308'
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- PeerJS for WebRTC -->
    <script src="https://unpkg.com/peerjs@1.5.2/dist/peerjs.min.js"></script>
    <!-- QRCode.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <style>
        /* Custom scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #0f172a; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #475569; }
        .tally-onair { animation: pulse-red 1.5s infinite; }
        @keyframes pulse-red {
            0%, 100% { opacity: 1; box-shadow: 0 0 15px rgba(239, 68, 68, 0.8); }
            50% { opacity: 0.5; box-shadow: 0 0 5px rgba(239, 68, 68, 0.3); }
        }
        /* Floating Emojis */
        .floating-emoji {
            position: absolute;
            bottom: 20px;
            font-size: 2rem;
            pointer-events: none;
            animation: floatUp 2s ease-out forwards;
        }
        @keyframes floatUp {
            0% { transform: translateY(0) scale(0.8); opacity: 1; }
            100% { transform: translateY(-180px) scale(1.4); opacity: 0; }
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 font-sans min-h-screen flex flex-col antialiased selection:bg-blue-600 selection:text-white">

    <!-- Top Navigation Header -->
    <header class="bg-slate-900 border-b border-slate-800 sticky top-0 z-50 px-4 py-3">
        <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-4">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center shadow-lg shadow-blue-500/20">
                    <i class="fa-solid font-bold fa-broadcast-tower text-white text-xl"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight flex items-center gap-2">
                        OmniLive Studio
                        <span class="text-xs bg-blue-500/10 text-blue-400 border border-blue-500/20 px-2 py-0.5 rounded-full">v2.5 WebRTC</span>
                    </h1>
                    <p class="text-xs text-slate-400">GitHub Pages 免伺服器多端直播導播系統</p>
                </div>
            </div>

            <!-- View Switcher Tabs -->
            <nav class="flex bg-slate-950 p-1 rounded-xl border border-slate-800 text-sm font-medium">
                <button onclick="switchRole('studio')" id="tab-studio" class="role-tab flex items-center gap-2 px-4 py-1.5 rounded-lg bg-blue-600 text-white transition-all shadow">
                    <i class="fa-solid fa-sliders"></i>
                    <span>後置統整導播室</span>
                </button>
                <button onclick="switchRole('camera')" id="tab-camera" class="role-tab flex items-center gap-2 px-4 py-1.5 rounded-lg text-slate-400 hover:text-white transition-all">
                    <i class="fa-solid fa-video"></i>
                    <span>拍攝端 (Cam)</span>
                </button>
                <button onclick="switchRole('viewer')" id="tab-viewer" class="role-tab flex items-center gap-2 px-4 py-1.5 rounded-lg text-slate-400 hover:text-white transition-all">
                    <i class="fa-solid fa-tv"></i>
                    <span>播放前端 (Viewer)</span>
                </button>
                <button onclick="switchRole('guide')" id="tab-guide" class="role-tab flex items-center gap-2 px-4 py-1.5 rounded-lg text-slate-400 hover:text-white transition-all">
                    <i class="fa-solid fa-book-open"></i>
                    <span>部署教學</span>
                </button>
            </nav>

            <!-- Room ID & Quick Status -->
            <div class="flex items-center space-x-3 text-xs bg-slate-800/80 px-3 py-1.5 rounded-lg border border-slate-700">
                <span class="text-slate-400">頻道/房間 ID:</span>
                <input type="text" id="globalRoomId" value="live-demo-room" class="bg-slate-900 border border-slate-700 rounded px-2 py-1 text-blue-400 font-mono w-32 focus:outline-none focus:border-blue-500" onchange="updateRoomId(this.value)">
                <button onclick="copyShareLink()" class="text-slate-300 hover:text-white title="複製連結"><i class="fa-regular fa-copy"></i></button>
            </div>
        </div>
    </header>

    <!-- WebSocket Sandbox Environment Warning Banner -->
    <div id="wsWarningBanner" class="hidden bg-amber-500/10 border-b border-amber-500/20 px-4 py-2 text-xs text-amber-300 flex items-center justify-between">
        <div class="flex items-center gap-2 max-w-7xl mx-auto w-full">
            <i class="fa-solid fa-triangle-exclamation text-amber-400"></i>
            <span id="wsWarningText">預覽環境 (iFrame Sandbox) 限制跨網域 WebSocket 連線。導播控制、鏡頭錄影與畫面合成仍可正常測試；部署至 GitHub Pages 後即恢復完整的跨裝置 WebRTC 串流功能！</span>
        </div>
        <button onclick="document.getElementById('wsWarningBanner').classList.add('hidden')" class="text-amber-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
    </div>

    <!-- Main Content Container -->
    <main class="flex-1 p-4 max-w-7xl w-full mx-auto">

        <!-- ==================== 1. DIRECTOR STUDIO MODULE ==================== -->
        <section id="module-studio" class="role-module space-y-4">
            <!-- Top Controls & Status Bar -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 flex items-center justify-between">
                    <div>
                        <div class="text-xs text-slate-400">導播室狀態</div>
                        <div id="studioPeerStatus" class="text-sm font-semibold text-amber-400 flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span> 正在初始化...
                        </div>
                    </div>
                    <button onclick="initStudio()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-xs rounded-lg border border-slate-700">
                        <i class="fa-solid fa-rotate-right mr-1"></i>重新連線
                    </button>
                    <button onclick="showPeerConfigModal()" class="px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-xs rounded-lg border border-slate-700 text-slate-300" title="PeerServer 設定">
                        <i class="fa-solid fa-gear"></i>
                    </button>
                </div>

                <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 flex items-center justify-between">
                    <div>
                        <div class="text-xs text-slate-400">線上觀看人數</div>
                        <div id="viewerCountText" class="text-lg font-bold text-emerald-400">0 位觀眾</div>
                    </div>
                    <i class="fa-solid fa-users text-2xl text-slate-700"></i>
                </div>

                <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 flex items-center justify-between">
                    <div>
                        <div class="text-xs text-slate-400">PGM 串流錄製</div>
                        <div id="recordTimeText" class="text-xs font-mono text-slate-400">00:00:00</div>
                    </div>
                    <button id="recordBtn" onclick="toggleRecord()" class="px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white text-xs font-semibold rounded-lg flex items-center gap-1.5">
                        <i class="fa-solid fa-circle text-[10px]"></i> 開始錄影
                    </button>
                </div>
            </div>

            <!-- Video Bus Area: PVW (Preview) and PGM (Program) -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <!-- PVW Box -->
                <div class="bg-slate-900 border-2 border-yellow-500/80 rounded-2xl p-3 shadow-xl relative overflow-hidden flex flex-col">
                    <div class="flex justify-between items-center mb-2 px-1">
                        <span class="bg-yellow-500 text-slate-950 font-bold px-2.5 py-0.5 rounded text-xs tracking-wider uppercase">PVW 預覽畫面</span>
                        <span id="pvwSourceText" class="text-xs text-slate-400">Source: CAM 1</span>
                    </div>
                    <div class="relative aspect-video bg-black rounded-xl overflow-hidden flex items-center justify-center border border-slate-800">
                        <canvas id="pvwCanvas" class="w-full h-full object-contain"></canvas>
                    </div>
                </div>

                <!-- PGM Box -->
                <div class="bg-slate-900 border-2 border-red-500 rounded-2xl p-3 shadow-xl relative overflow-hidden flex flex-col">
                    <div class="flex justify-between items-center mb-2 px-1">
                        <div class="flex items-center gap-2">
                            <span class="bg-red-600 text-white font-bold px-2.5 py-0.5 rounded text-xs tracking-wider uppercase tally-onair">PGM 正式播出 (ON AIR)</span>
                            <span id="pgmFpsText" class="text-xs text-emerald-400 font-mono">60 FPS</span>
                        </div>
                        <span id="pgmSourceText" class="text-xs text-slate-400">Source: CAM 1</span>
                    </div>
                    <div class="relative aspect-video bg-black rounded-xl overflow-hidden flex items-center justify-center border border-slate-800">
                        <canvas id="pgmCanvas" class="w-full h-full object-contain"></canvas>
                        <!-- PGM Overlay indicators -->
                        <div id="pgmOverlayLowerThird" class="hidden absolute bottom-6 left-6 bg-slate-900/90 backdrop-blur border-l-4 border-blue-500 px-4 py-2 rounded-r shadow-2xl">
                            <div id="ltTitle" class="font-bold text-white text-base">即時導播直播</div>
                            <div id="ltSubtitle" class="text-xs text-blue-400">OmniLive Multi-Cam System</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Transition & Switcher Controls Bar -->
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-4">
                <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-800 pb-3">
                    <h3 class="font-bold text-sm text-slate-300 flex items-center gap-2">
                        <i class="fa-solid fa-arrows-split-up-and-left text-blue-400"></i>
                        導播切換控制台 (Switcher Bar)
                    </h3>
                    <div class="flex items-center gap-2">
                        <button onclick="triggerCut()" class="px-5 py-2 bg-red-600 hover:bg-red-500 font-bold text-white text-sm rounded-xl shadow-lg shadow-red-600/30 transition">
                            CUT (硬切)
                        </button>
                        <button onclick="triggerAutoFade()" class="px-5 py-2 bg-yellow-600 hover:bg-yellow-500 font-bold text-white text-sm rounded-xl shadow-lg shadow-yellow-600/30 transition">
                            AUTO (淡入淡出 1s)
                        </button>
                    </div>
                </div>

                <!-- Layout / Transition Effect Options -->
                <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-2">
                    <button onclick="setLayout('single')" class="layout-btn bg-slate-800 hover:bg-slate-700 active border border-blue-500 text-xs py-2 px-3 rounded-lg text-center font-medium">
                        <i class="fa-solid fa-square block text-base mb-1 text-blue-400"></i> 單一畫面
                    </button>
                    <button onclick="setLayout('pip')" class="layout-btn bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs py-2 px-3 rounded-lg text-center font-medium">
                        <i class="fa-solid fa-clone block text-base mb-1 text-slate-400"></i> 畫中畫 (PiP)
                    </button>
                    <button onclick="setLayout('split')" class="layout-btn bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs py-2 px-3 rounded-lg text-center font-medium">
                        <i class="fa-solid fa-columns block text-base mb-1 text-slate-400"></i> 左右分鏡 (50/50)
                    </button>
                    <button onclick="setLayout('grid')" class="layout-btn bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs py-2 px-3 rounded-lg text-center font-medium">
                        <i class="fa-solid fa-border-all block text-base mb-1 text-slate-400"></i> 4分割鏡頭
                    </button>
                    <button onclick="toggleOverlay('lowerThird')" class="bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs py-2 px-3 rounded-lg text-center font-medium text-slate-300">
                        <i class="fa-solid fa-id-card block text-base mb-1 text-indigo-400"></i> 下三分字幕
                    </button>
                    <button onclick="toggleOverlay('ticker')" class="bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs py-2 px-3 rounded-lg text-center font-medium text-slate-300">
                        <i class="fa-solid fa-scroll block text-base mb-1 text-amber-400"></i> 跑馬燈字幕
                    </button>
                </div>
            </div>

            <!-- Video Sources Grid & Audio Mixer -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
                <!-- Video Inputs Selection (2 Columns) -->
                <div class="lg:col-span-2 bg-slate-900 border border-slate-800 rounded-2xl p-4">
                    <h3 class="font-bold text-sm text-slate-300 mb-3 flex items-center justify-between">
                        <span><i class="fa-solid fa-video text-blue-400 mr-2"></i>輸入訊號源矩陣 (Inputs Matrix)</span>
                        <span class="text-xs text-slate-500">點擊點選 PVW 預覽</span>
                    </h3>

                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3" id="cameraSlotsContainer">
                        <!-- Dynamic Camera Slots generated via JS -->
                    </div>
                </div>

                <!-- Audio Mixer & Graphics Overlay Panel -->
                <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex flex-col justify-between space-y-4">
                    <div>
                        <h3 class="font-bold text-sm text-slate-300 mb-3 flex items-center gap-2">
                            <i class="fa-solid fa-sliders text-emerald-400"></i>
                            音訊混音器 (Audio Mixer)
                        </h3>
                        <div class="space-y-3 text-xs" id="audioMixerControls">
                            <!-- Dynamic Audio Controls -->
                            <div>
                                <div class="flex justify-between mb-1">
                                    <span class="text-slate-400">主音訊輸出 (Master)</span>
                                    <span id="masterVolText" class="text-emerald-400 font-mono">100%</span>
                                </div>
                                <input type="range" id="masterVolSlider" min="0" max="1" step="0.01" value="1" oninput="adjustMasterVolume(this.value)" class="w-full accent-emerald-500 bg-slate-800">
                            </div>
                        </div>
                    </div>

                    <!-- Lower Third Text Inputs -->
                    <div class="border-t border-slate-800 pt-3 space-y-2 text-xs">
                        <div class="font-semibold text-slate-300">字幕字板設定</div>
                        <input type="text" id="inputLtTitle" value="歡迎收看 OmniLive 線上直播" placeholder="主標題..." class="w-full bg-slate-950 border border-slate-800 rounded p-2 text-slate-200 focus:outline-none focus:border-blue-500">
                        <input type="text" id="inputLtSub" value="GitHub Pages 全前端 WebRTC 架構" placeholder="副標題..." class="w-full bg-slate-950 border border-slate-800 rounded p-2 text-slate-200 focus:outline-none focus:border-blue-500">
                        <input type="text" id="inputTicker" value="🔥 歡迎加入直播間！有任何問題歡迎在聊天室留言發問。點擊右下角點讚支持！" placeholder="跑馬燈文字..." class="w-full bg-slate-950 border border-slate-800 rounded p-2 text-slate-200 focus:outline-none focus:border-blue-500">
                    </div>
                </div>
            </div>
        </section>

        <!-- ==================== 2. CAMERA NODE MODULE ==================== -->
        <section id="module-camera" class="role-module hidden max-w-2xl mx-auto space-y-4">
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-5">
                <div class="flex justify-between items-center border-b border-slate-800 pb-4">
                    <div>
                        <h2 class="text-lg font-bold flex items-center gap-2">
                            <i class="fa-solid fa-camera text-blue-400"></i>
                            拍攝端機位設定 (Camera Node)
                        </h2>
                        <p class="text-xs text-slate-400">將此設備的視訊與麥克風回傳給導播室</p>
                    </div>
                    <!-- Tally Status Box -->
                    <div id="cameraTally" class="px-3 py-1.5 rounded-lg font-bold text-xs bg-slate-800 text-slate-400 border border-slate-700">
                        狀態: 離線
                    </div>
                </div>

                <!-- Live Camera Preview Frame -->
                <div class="relative aspect-video bg-black rounded-xl overflow-hidden border border-slate-800 flex items-center justify-center group">
                    <video id="camLocalVideo" autoplay playsinline muted class="w-full h-full object-cover"></video>
                    <div id="camPlaceholder" class="absolute inset-0 flex flex-col items-center justify-center text-slate-500 bg-slate-950">
                        <i class="fa-solid fa-video-slash text-4xl mb-2"></i>
                        <span class="text-xs">鏡頭未開啟</span>
                    </div>
                </div>

                <!-- Device Controls -->
                <div class="space-y-4 text-xs">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-slate-400 mb-1">視訊來源</label>
                            <select id="videoSelect" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-slate-200 focus:outline-none focus:border-blue-500"></select>
                        </div>
                        <div>
                            <label class="block text-slate-400 mb-1">音訊來源 (麥克風)</label>
                            <select id="audioSelect" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-slate-200 focus:outline-none focus:border-blue-500"></select>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-slate-400 mb-1">解析度與幀率</label>
                            <select id="resSelect" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-slate-200">
                                <option value="1080">1080p (Full HD / 60FPS)</option>
                                <option value="720" selected>720p (HD / 30FPS)</option>
                                <option value="480">480p (SD / 30FPS)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-slate-400 mb-1">分配機位 (Cam Slot)</label>
                            <select id="camSlotSelect" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-slate-200">
                                <option value="cam1">Cam 1 (鏡頭 1)</option>
                                <option value="cam2">Cam 2 (鏡頭 2)</option>
                                <option value="cam3">Cam 3 (鏡頭 3)</option>
                                <option value="cam4">Cam 4 (鏡頭 4)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex flex-wrap gap-3 pt-2">
                        <button onclick="startCameraNode()" class="flex-1 py-3 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-xl transition shadow-lg shadow-blue-600/30 flex items-center justify-center gap-2">
                            <i class="fa-solid fa-play"></i> 開啟鏡頭並連線至導播室
                        </button>
                        <button onclick="startScreenShareNode()" class="py-3 px-4 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-desktop"></i> 螢幕分享
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==================== 3. VIEWER PLAYER MODULE ==================== -->
        <section id="module-viewer" class="role-module hidden max-w-5xl mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
                <!-- Video Player Column (2 Cols) -->
                <div class="lg:col-span-2 space-y-3">
                    <div class="relative aspect-video bg-black rounded-2xl overflow-hidden border border-slate-800 shadow-2xl group" id="viewerVideoContainer">
                        <video id="viewerVideo" autoplay playsinline class="w-full h-full object-contain"></video>

                        <!-- Unmute overlay banner if autoplay blocked audio -->
                        <div id="unmuteOverlay" onclick="unmuteViewer()" class="absolute inset-0 bg-black/60 backdrop-blur-sm flex flex-col items-center justify-center text-white cursor-pointer transition">
                            <div class="w-16 h-16 rounded-full bg-blue-600 flex items-center justify-center text-2xl mb-3 shadow-xl animate-bounce">
                                <i class="fa-solid fa-volume-xmark"></i>
                            </div>
                            <p class="font-bold text-sm">點擊畫面開啟聲音聲音</p>
                        </div>

                        <!-- Floating Emojis Layer -->
                        <div id="emojiLayer" class="absolute inset-0 pointer-events-none overflow-hidden"></div>

                        <!-- Live Badge Overlay -->
                        <div class="absolute top-4 left-4 flex items-center gap-2 bg-black/60 backdrop-blur px-3 py-1 rounded-full text-xs">
                            <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-pulse"></span>
                            <span class="font-bold tracking-wider text-white uppercase">LIVE 直播中</span>
                        </div>
                    </div>

                    <!-- Viewer Control & Details -->
                    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex items-center justify-between">
                        <div>
                            <h2 class="font-bold text-base text-white">OmniLive 全端 WebRTC 直播間</h2>
                            <p class="text-xs text-slate-400">超低延遲線上直播 (Peer-to-Peer 傳輸)</p>
                        </div>
                        <div class="flex items-center space-x-2">
                            <button onclick="sendEmoji('❤️')" class="w-10 h-10 rounded-full bg-slate-800 hover:bg-slate-700 text-lg flex items-center justify-center transition active:scale-95">❤️</button>
                            <button onclick="sendEmoji('🔥')" class="w-10 h-10 rounded-full bg-slate-800 hover:bg-slate-700 text-lg flex items-center justify-center transition active:scale-95">🔥</button>
                            <button onclick="sendEmoji('👏')" class="w-10 h-10 rounded-full bg-slate-800 hover:bg-slate-700 text-lg flex items-center justify-center transition active:scale-95">👏</button>
                            <button onclick="sendEmoji('🎉')" class="w-10 h-10 rounded-full bg-slate-800 hover:bg-slate-700 text-lg flex items-center justify-center transition active:scale-95">🎉</button>
                        </div>
                    </div>
                </div>

                <!-- Chatroom Column (1 Col) -->
                <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex flex-col h-[500px]">
