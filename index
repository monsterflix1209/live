                <button onclick="savePeerConfig()" class="flex-1 py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-xl text-xs font-bold">儲存並重連</button>
                <button onclick="hidePeerConfigModal()" class="py-2 px-4 bg-slate-800 hover:bg-slate-700 text-white rounded-xl text-xs">取消</button>
